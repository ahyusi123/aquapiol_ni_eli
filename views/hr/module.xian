{{> head}}
<body class="hr-body"><div class="hr-shell"><aside class="hr-sidebar">
<a href="/hr" class="brand"><span class="brand-icon">✦</span><span><b>AquaPiol</b><small>HR Management System</small></span></a>
<div class="nav-label">WORKSPACE</div><a class="nav-item" href="/hr">▦　Dashboard</a><div class="nav-label">HUMAN RESOURCES</div>
<a class="nav-item {{#if (eq active 'employees')}}active{{/if}}" href="/hr/employees">♙　Employees</a><a class="nav-item" href="/hr/attendance">◷　Attendance</a><a class="nav-item" href="/hr/leaves">▣　Leave Management</a><a class="nav-item" href="/hr/schedules">▤　Schedules</a><div class="nav-label">COMPENSATION & RECORDS</div><a class="nav-item" href="/hr/payroll">₱　Payroll</a><a class="nav-item" href="/hr/records">▧　Employee Records</a><a class="nav-item" href="/hr/performance">★　Performance</a><a class="nav-item" href="/hr/reports">▥　HR Reports</a><div class="sidebar-user"><div class="avatar">HR</div><div><b>HR Administrator</b><small>System Admin</small></div></div><form method="POST" action="/logout" class="signout-form"><button type="submit" class="nav-item signout">⎋　Sign out</button></form></aside>
<main class="hr-main"><header class="topbar"><span>AquaPiol / {{config.title}}</span><span class="top-user">HR Administrator　●</span></header><section class="page-content">
<div class="page-heading"><div><p class="eyebrow">HUMAN RESOURCES</p><h1>{{config.title}}</h1><p class="muted">{{config.subtitle}}</p></div><button class="btn-primary" onclick="document.getElementById('addForm').scrollIntoView({behavior:'smooth'})">＋ Add record</button></div>
{{#if success_msg}}<div class="alert success">{{success_msg}}</div>{{/if}}{{#if error_msg}}<div class="alert error">{{error_msg}}</div>{{/if}}
<section class="panel table-panel"><div class="panel-head"><div><h3>Records</h3><p>Latest 250 records · {{rows.length}} shown</p></div><input class="search-input" id="tableSearch" placeholder="Search records…"></div><div class="table-wrap"><table id="recordsTable"><thead><tr>{{#each columns}}<th>{{this.[1]}}</th>{{/each}}<th>Created</th><th>Action</th></tr></thead><tbody>
{{#each rows}}<tr>{{#each ../columns}}<td>{{lookup ../this (lookup this 0)}}</td>{{/each}}<td>{{createdAt}}</td><td><form method="POST" action="/hr/{{../active}}/delete/{{id}}" onsubmit="return confirm('Delete this record?')"><button class="delete-btn">Delete</button></form></td></tr>{{else}}<tr><td colspan="20" class="empty">No records yet. Add your first record below.</td></tr>{{/each}}
</tbody></table></div></section>
<section class="panel form-panel" id="addForm"><div class="panel-head"><div><h3>Add new record</h3><p>Complete the fields and save to the database.</p></div></div><form method="POST" action="/hr/{{active}}" class="form-grid">
{{#each config.fields}}<label class="field">{{this.[1]}} {{#if (eq this.[0] 'employeeNo')}}<span class="required">*</span>{{/if}}
{{#if (startsWith this.[2] 'select:')}}<select name="{{this.[0]}}" {{#if (eq this.[0] 'employeeNo')}}required{{/if}}>{{#each (split (replace this.[2] 'select:' '') ',')}}<option>{{this}}</option>{{/each}}</select>
{{else}}{{#if (eq this.[2] 'textarea')}}<textarea name="{{this.[0]}}" rows="2"></textarea>{{else}}<input name="{{this.[0]}}" type="{{this.[2]}}" {{#if (eq this.[0] 'employeeNo')}}required{{/if}} {{#if (eq this.[2] 'number')}}step="0.01" min="0"{{/if}}>{{/if}}{{/if}}</label>{{/each}}
<div class="form-actions"><button class="btn-primary" type="submit">Save record</button><button class="btn-light" type="reset">Clear</button></div></form></section>
</section></main></div>{{> footer}}
