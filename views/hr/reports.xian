{{> head}}<body class="hr-body"><div class="hr-shell"><aside class="hr-sidebar"><a href="/hr" class="brand"><span class="brand-icon">✦</span><span><b>AquaPiol</b><small>HR Management System</small></span></a><div class="nav-label">WORKSPACE</div><a class="nav-item" href="/hr">▦　Dashboard</a><div class="nav-label">HUMAN RESOURCES</div><a class="nav-item" href="/hr/employees">♙　Employees</a><a class="nav-item" href="/hr/attendance">◷　Attendance</a><a class="nav-item" href="/hr/leaves">▣　Leave Management</a><a class="nav-item" href="/hr/schedules">▤　Schedules</a><div class="nav-label">COMPENSATION & RECORDS</div><a class="nav-item" href="/hr/payroll">₱　Payroll</a><a class="nav-item" href="/hr/records">▧　Employee Records</a><a class="nav-item" href="/hr/performance">★　Performance</a><a class="nav-item active" href="/hr/reports">▥　HR Reports</a><div class="sidebar-user"><div class="avatar">HR</div><div><b>HR Administrator</b><small>System Admin</small></div></div><form method="POST" action="/logout" class="signout-form"><button type="submit" class="nav-item signout">⎋　Sign out</button></form></aside><main class="hr-main"><header class="topbar"><span>AquaPiol / Insights</span><span class="top-user">HR Administrator　●</span></header><section class="page-content"><div class="page-heading"><div><p class="eyebrow">INSIGHTS</p><h1>HR Reports</h1><p class="muted">Quick workforce summary from your records.</p></div><button class="btn-primary" onclick="window.print()">⤓ Print report</button></div><div class="stats-grid"><div class="stat-card"><span class="stat-icon cyan">♙</span><div><small>EMPLOYEES</small><strong>{{employees.length}}</strong></div></div><div class="stat-card"><span class="stat-icon blue">◷</span><div><small>ATTENDANCE ENTRIES</small><strong>{{attendance.length}}</strong></div></div><div class="stat-card"><span class="stat-icon amber">▣</span><div><small>LEAVE REQUESTS</small><strong>{{leaves.length}}</strong></div></div><div class="stat-card"><span class="stat-icon violet">₱</span><div><small>PAYROLL RECORDS</small><strong>{{payroll.length}}</strong></div></div></div><section class="panel"><div class="panel-head"><div><h3>Employee directory summary</h3><p>Current employee profile list</p></div></div><div class="table-wrap"><table><thead><tr><th>Employee No.</th><th>Name</th><th>Department</th><th>Position</th><th>Status</th></tr></thead><tbody>{{#each employees}}<tr><td>{{employeeNo}}</td><td>{{firstName}} {{lastName}}</td><td>{{department}}</td><td>{{position}}</td><td>{{employmentStatus}}</td></tr>{{else}}<tr><td colspan="5" class="empty">No employee records available.</td></tr>{{/each}}</tbody></table></div></section></section></main></div>{{> footer}}
