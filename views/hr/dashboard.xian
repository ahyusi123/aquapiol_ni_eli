{{> head}}
<body class="hr-body"><div class="hr-shell"><aside class="hr-sidebar">
<a href="/hr" class="brand"><span class="brand-icon">✦</span><span><b>AquaPiol</b><small>HR Management System</small></span></a>
<div class="nav-label">WORKSPACE</div><a class="nav-item active" href="/hr">▦　Dashboard</a>
<div class="nav-label">HUMAN RESOURCES</div><a class="nav-item" href="/hr/employees">♙　Employees</a><a class="nav-item" href="/hr/attendance">◷　Attendance</a><a class="nav-item" href="/hr/leaves">▣　Leave Management</a><a class="nav-item" href="/hr/schedules">▤　Schedules</a>
<div class="nav-label">COMPENSATION & RECORDS</div><a class="nav-item" href="/hr/payroll">₱　Payroll</a><a class="nav-item" href="/hr/records">▧　Employee Records</a><a class="nav-item" href="/hr/performance">★　Performance</a><a class="nav-item" href="/hr/reports">▥　HR Reports</a>
<div class="sidebar-user"><div class="avatar">HR</div><div><b>HR Administrator</b><small>System Admin</small></div></div><form method="POST" action="/logout" class="signout-form"><button type="submit" class="nav-item signout">⎋　Sign out</button></form></aside>
<main class="hr-main"><header class="topbar"><span>AquaPiol / Overview</span><span class="top-user">HR Administrator　●</span></header><section class="page-content">
<div class="page-heading"><div><p class="eyebrow">OVERVIEW</p><h1>Dashboard</h1><p class="muted">Welcome back! Here's your workforce overview.</p></div><a class="btn-primary" href="/hr/employees">＋ Add employee</a></div>
<div class="welcome-card"><div><span class="pill">WORKFORCE PULSE</span><h2>Good to see you, HR Admin!</h2><p>Manage your people, attendance, and employee lifecycle in one place.</p></div><div class="welcome-mark">✦</div></div>
<div class="stats-grid"><a class="stat-card" href="/hr/employees"><span class="stat-icon cyan">♙</span><div><small>TOTAL EMPLOYEES</small><strong>{{stats.employees}}</strong><span class="stat-foot">Employee profiles</span></div></a><a class="stat-card" href="/hr/attendance"><span class="stat-icon blue">◷</span><div><small>ATTENDANCE LOGS</small><strong>{{stats.attendance}}</strong><span class="stat-foot">Recorded entries</span></div></a><a class="stat-card" href="/hr/leaves"><span class="stat-icon amber">▣</span><div><small>PENDING LEAVES</small><strong>{{stats.leaves}}</strong><span class="stat-foot">Awaiting approval</span></div></a><a class="stat-card" href="/hr/payroll"><span class="stat-icon violet">₱</span><div><small>PAYROLL RECORDS</small><strong>{{stats.payroll}}</strong><span class="stat-foot">Payroll entries</span></div></a></div>
<div class="content-grid"><section class="panel"><div class="panel-head"><div><h3>HR Workspace</h3><p>Quick access to your modules</p></div></div><div class="quick-grid"><a href="/hr/employees">♙ <b>Employee Management</b><small>Profiles & employee data →</small></a><a href="/hr/attendance">◷ <b>Attendance</b><small>Time-in / time-out →</small></a><a href="/hr/leaves">▣ <b>Leave Management</b><small>Review requests →</small></a><a href="/hr/schedules">▤ <b>Schedules</b><small>Work shifts →</small></a><a href="/hr/payroll">₱ <b>Payroll</b><small>Salary computation →</small></a><a href="/hr/reports">▥ <b>HR Reports</b><small>Workforce summaries →</small></a></div></section><section class="panel"><div class="panel-head"><div><h3>System modules</h3><p>All-in-one employee lifecycle</p></div></div><div class="module-list"><div>Employee Profiles <span>Ready</span></div><div>Attendance Monitoring <span>Ready</span></div><div>Leave & Schedule <span>Ready</span></div><div>Payroll & Reports <span>Ready</span></div><div>Performance & Records <span>Ready</span></div></div></section></div>
</section></main></div>{{> footer}}
